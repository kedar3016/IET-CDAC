<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans.xsd
        http://www.springframework.org/schema/context
        http://www.springframework.org/schema/context/spring-context.xsd">




<bean id ="hw" class ="com.demo.beans.HelloWorld"/>



<!-- Setter Injection -->
<bean id = "emp1" class="com.demo.beans.Employee">
<property name="eid" value = "101"></property>
<property name="ename" value ="Kedar"></property>
<property name="sal" value = "85000"></property>
</bean>


<!-- Constructor Injection -->
<bean id = "emp2" class ="com.demo.beans.Employee">
	<constructor-arg index="0" value="102"></constructor-arg>
	<constructor-arg index = "1" value = "Krishna"></constructor-arg>
	<constructor-arg index="2" value = "524333"></constructor-arg>

</bean>

<bean id = "add1" class = "com.demo.beans.Address">
	<property name="street" value = "SB Road"></property>
	<property name="city" value = "pune"></property>
	<property name="pincode" value = "416232"></property>
</bean>

<bean id = "u1" class = "com.demo.beans.MyUser">
	<property name="uid" value = "105"></property>
	<property name="uname" value = "KedarMane"></property>
	<property name="email" value = "Kedarmane3016@gmail.com"></property>
	<property name= "addr" ref = "add1"></property>
</bean>
</beans>