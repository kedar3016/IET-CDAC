<taglib>
	<tlib-version>1.0</tlib-version>
	<jsp-version>1.1</jsp-version>
    <uri>/mytaglib</uri>
	
	<tag>
		<name>myhellotag</name>
		<tag-class>com.demo.tag.HelloTagHandler</tag-class>
		<attribute>
			<name>fname</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
           <name>lname</name>
           <required>true</required>
           <rtexprvalue>true</rtexprvalue>
       </attribute>
	</tag>
</taglib>