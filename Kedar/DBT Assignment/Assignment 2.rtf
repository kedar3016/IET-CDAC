{\listtext\f0 1.\tab}\jclisttab\tx360\ls1\ilvl8\fi-360\li360\expndtw-5\b\i\f0\fs28 Display the Employee Name, Job, and Start Date of Employees hired from February 1981 to May 1981.\b0\fs24\par

\pard\widctlpar\b\fs28 ->\b0\fs24   \i0\f1 mysql> select ename Name,job Job, hiredate 'Start Date' from emp where extract(year_month from hiredate) >= '198102' and extract(year_month from hiredate) < '198105';\par
